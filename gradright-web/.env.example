# Optional: reserved for a future NextAuth integration (not used by current Supabase auth).
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle + pg: use Session pooler URI if db.<ref>.supabase.co fails (ENOTFOUND on some networks).
# User is often postgres.<project-ref>. Host like aws-0-<region>.pooler.supabase.com:5432
# URL-encode special chars in the password (/ → %2F, % → %25).
DATABASE_URL=

ANTHROPIC_API_KEY=

# Google Gemini — /api/ai/chat mentor + dashboard brief (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Alternative names (same key): GOOGLE_GENERATIVE_AI_API_KEY or GOOGLE_API_KEY
# e.g. gemini-2.0-flash or gemini-1.5-flash
GEMINI_MODEL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RISK_ENGINE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_TEXTRACT_BUCKET=

RESEND_API_KEY=
# Verified sender in Resend, e.g. GradRight <weekly@yourdomain.com>
RESEND_FROM_EMAIL=

# Vercel Cron: set the same value in Vercel project env; send Authorization: Bearer <secret> for manual runs
CRON_SECRET=

# Cap per cron invocation (default 120)
WEEKLY_DIGEST_MAX_USERS=

NEXT_PUBLIC_APP_URL=

# Split dev servers: student (:3000) vs Insights / NBFC (:3001). See package.json `dev:student` / `dev:nbfc`.
NEXT_PUBLIC_PORTAL_MODE=
NEXT_PUBLIC_STUDENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_NBFC_ORIGIN=http://localhost:3001

# Local/demo only: allows POST /api/auth/complete-partner-signup after partner self-registration on the Insights host.
# After pulling NBFC auth fixes, run `pnpm db:push` so migration `0001_users_rls_authenticated_read` applies (RLS SELECT on public.users for JWT — required for middleware role checks).
ALLOW_NBFC_SELF_SIGNUP=

# GradRight Python FastAPI (PYTHON_SETUP)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Legacy CRA variable name only if you still run an external Lovable bundle against the same API.
# REACT_APP_API_URL=http://localhost:8000

NODE_ENV=
