# Optional: reserved for a future NextAuth integration (not used by current Supabase auth).
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for /api/user/profile-resume (and loan doc uploads): Storage upload uses the service role. Without it, uploads fall back to the user session and often fail with 503 unless Storage RLS allows inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Drizzle + pg: use Session pooler URI if db.<ref>.supabase.co fails (ENOTFOUND on some networks).
# User is often postgres.<project-ref>. Host like aws-0-<region>.pooler.supabase.com:5432
# URL-encode special chars in the password (/ → %2F, % → %25).
DATABASE_URL=

# Optional legacy — not used by current GradRight web AI paths.
ANTHROPIC_API_KEY=

# AI — single Gemini key. All web AI routes use this only.
# File must live in this folder (`gradright-web/.env.local`), not only the monorepo root. Save the file after edits, then restart `pnpm dev`.
GEMINI_API_KEY=
# Optional: model id for generateContent (default: gemini-2.5-flash). New API keys often get 404 on gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Optional alias (same key) if you already use Google’s documented name:
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: global Gemini requests per minute (sliding window). Legacy alias: GEMINI_PER_ENGINE_RPM.
# GEMINI_RPM=24

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RISK_ENGINE_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_TEXTRACT_BUCKET=

RESEND_API_KEY=
# Verified sender in Resend, e.g. GradRight <weekly@yourdomain.com>
RESEND_FROM_EMAIL=

# Vercel Cron: set the same value in Vercel project env; send Authorization: Bearer <secret> for manual runs
CRON_SECRET=

# Cap per cron invocation (default 120)
WEEKLY_DIGEST_MAX_USERS=

NEXT_PUBLIC_APP_URL=

# Split dev servers: student (:3000) vs Insights / NBFC (:3001). See package.json `dev:student` / `dev:nbfc`.
NEXT_PUBLIC_PORTAL_MODE=
NEXT_PUBLIC_STUDENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_NBFC_ORIGIN=http://localhost:3001

# Local/demo only: allows POST /api/auth/complete-partner-signup after partner self-registration on the Insights host.
# After pulling NBFC auth fixes, run `pnpm db:push` so migration `0001_users_rls_authenticated_read` applies (RLS SELECT on public.users for JWT — required for middleware role checks).
ALLOW_NBFC_SELF_SIGNUP=

# GradRight Python FastAPI (PYTHON_SETUP)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Legacy CRA variable name only if you still run an external Lovable bundle against the same API.
# REACT_APP_API_URL=http://localhost:8000

NODE_ENV=

# Local Gemini debug route (non-production or GRADRIGHT_GEMINI_DEBUG_ROUTE=true)
# GRADRIGHT_GEMINI_DEBUG_ROUTE=
# GRADRIGHT_GEMINI_FORENSIC=1
