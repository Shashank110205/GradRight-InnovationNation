{
  "name": "gradright-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:diag": "node scripts/next-dev-eprem-diagnostics.mjs",
    "dev": "cross-env PORT=3000 NEXT_PUBLIC_NBFC_ORIGIN=http://localhost:3001 next dev --webpack",
    "dev:student": "cross-env PORT=3000 NEXT_PUBLIC_NBFC_ORIGIN=http://localhost:3001 next dev --webpack",
    "dev:nbfc": "cross-env NEXT_DIST_DIR=.next-nbfc NEXT_PUBLIC_PORTAL_MODE=nbfc NEXT_PUBLIC_STUDENT_ORIGIN=http://localhost:3000 NEXT_PUBLIC_NBFC_ORIGIN=http://localhost:3001 PORT=3001 next dev --webpack",
    "dev:ports:free": "node scripts/free-dev-ports.mjs",
    "dev:all": "node scripts/free-dev-ports.mjs && concurrently -n student,nbfc -c cyan,magenta \"pnpm dev:student\" \"pnpm dev:nbfc\"",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
